# Native Apple Silicon build of Keila v0.30.2.
# This follows upstream ops/Dockerfile; only source paths and pinned base-image
# digests differ because the source is fetched into .cache/keila.
FROM elixir:1.18-alpine@sha256:caa6412c072c4b11e8c6798108388702c2791b4f8bad41e42c27ea5be881e2dc AS build

ENV MIX_ENV=prod
WORKDIR /build

RUN apk add --no-cache git npm build-base openssl cmake

COPY .cache/keila/mix.exs .cache/keila/mix.lock ./
COPY .cache/keila/config ./config
RUN mix local.hex --force && \
    mix local.rebar --force && \
    mix deps.get && \
    mix deps.compile

COPY .cache/keila/assets/package.json .cache/keila/assets/package-lock.json ./assets/
RUN npm ci --prefix ./assets

COPY .cache/keila/ .
RUN mix deps.clean mime --build && \
    mix assets.deploy && \
    mix release

FROM elixir:1.18-otp-27-alpine@sha256:34260a722c6a6fa659aad9dd09e73466f5692a899e7edb60d43b0d51d4738c4f

ENV HOME=/opt/app
WORKDIR ${HOME}

COPY --from=build /build/_build/prod/rel/keila ${HOME}
RUN apk add --no-cache openssl && \
    mkdir -p ${HOME} && \
    adduser -s /bin/sh -u 1001 -G root -h ${HOME} -S -D default && \
    chown -R 1001:0 ${HOME}

ENTRYPOINT ["/opt/app/bin/keila"]
CMD ["start"]

ENV PORT=4000
EXPOSE 4000/tcp
