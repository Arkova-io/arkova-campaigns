# Copy to .env only when you need to supply your own local pilot credentials.
# ./scripts/pilot-up generates stronger random values automatically.
POSTGRES_PASSWORD=replace-with-a-random-value
SECRET_KEY_BASE=replace-with-at-least-64-random-bytes
KEILA_USER=admin@arkova.local
KEILA_PASSWORD=replace-with-a-random-value-at-least-10-characters
MAILPIT_PASSWORD=replace-with-a-random-value
KEILA_PORT=4000
MAILPIT_UI_PORT=8025
